<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InsiderEdge — Insider Trading Intelligence</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Syne:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0c0f;
    --bg2: #111418;
    --bg3: #191d24;
    --border: rgba(255,255,255,0.06);
    --border2: rgba(255,255,255,0.12);
    --text: #e8eaf0;
    --muted: #7a8099;
    --accent: #00e5b0;
    --accent2: #0099ff;
    --red: #ff4d6d;
    --amber: #ffaa00;
    --green: #00d085;
    --purple: #a78bfa;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Syne', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .mono { font-family: 'IBM Plex Mono', monospace; }

  /* Grid noise overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,176,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,176,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .wrapper { position: relative; z-index: 1; }

  /* NAV */
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2.5rem;
    border-bottom: 1px solid var(--border);
    background: rgba(10,12,15,0.9);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-mark {
    width: 32px; height: 32px;
    background: var(--accent);
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .logo-text span { color: var(--accent); }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s;
    cursor: pointer;
  }

  .nav-links a:hover, .nav-links a.active { color: var(--accent); }

  /* PAGE TRANSITIONS */
  .page { display: none; }
  .page.active { display: block; animation: fadeIn 0.25s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  /* PATTERNS PAGE */
  .patterns-hero {
    padding: 3rem 2.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .patterns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 0;
    border-bottom: 1px solid var(--border);
  }

  .pattern-card {
    padding: 2rem 2.5rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
  }

  .pattern-card:hover { background: rgba(255,255,255,0.02); }

  .pattern-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .pattern-type-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .pt-cluster { background: rgba(0,229,176,0.1); color: var(--accent); border: 1px solid rgba(0,229,176,0.2); }
  .pt-ceo { background: rgba(0,153,255,0.1); color: var(--accent2); border: 1px solid rgba(0,153,255,0.2); }
  .pt-contra { background: rgba(167,139,250,0.1); color: var(--purple); border: 1px solid rgba(167,139,250,0.2); }
  .pt-pre { background: rgba(255,170,0,0.1); color: var(--amber); border: 1px solid rgba(255,170,0,0.2); }
  .pt-neg { background: rgba(255,77,109,0.1); color: var(--red); border: 1px solid rgba(255,77,109,0.2); }

  .pattern-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .pattern-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .pattern-stats {
    display: flex;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .pstat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pstat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pstat-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* CASE STUDY SECTION */
  .case-studies {
    padding: 2.5rem;
  }

  .cs-header {
    margin-bottom: 2rem;
  }

  .cs-section-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .cs-title {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 1.5rem;
  }

  .cs-card {
    background: var(--bg2);
    border: 1px solid var(--border2);
    border-radius: 12px;
    overflow: hidden;
  }

  .cs-card-head {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cs-ticker-big {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .cs-outcome {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 6px;
  }

  .outcome-win { background: rgba(0,208,133,0.12); color: var(--green); }
  .outcome-loss { background: rgba(255,77,109,0.12); color: var(--red); }

  .cs-card-body { padding: 1.25rem 1.5rem; }

  .cs-timeline {
    margin: 1rem 0;
    position: relative;
  }

  .cs-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border2);
  }

  .cs-event {
    display: flex;
    gap: 16px;
    margin-bottom: 1rem;
    position: relative;
  }

  .cs-event-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 2px;
    border: 2px solid var(--bg2);
    z-index: 1;
  }

  .cs-event-content {}

  .cs-event-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .cs-event-text {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text);
  }

  .cs-return-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .return-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .return-track {
    flex: 1;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .return-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 1s ease;
  }

  .return-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* PATTERN EFFECTIVENESS TABLE */
  .effectiveness-section {
    padding: 0 2.5rem 2.5rem;
  }

  .eff-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .eff-table thead tr {
    background: var(--bg2);
  }

  .eff-table th {
    padding: 0.85rem 1.25rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--border);
  }

  .eff-table tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.12s;
  }

  .eff-table tbody tr:last-child { border-bottom: none; }
  .eff-table tbody tr:hover { background: rgba(255,255,255,0.02); }

  .eff-table td {
    padding: 1rem 1.25rem;
    font-size: 0.85rem;
  }

  .win-rate-bar {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .wr-track {
    width: 80px;
    height: 5px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .wr-fill { height: 100%; border-radius: 3px; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0,229,176,0.08);
    border: 1px solid rgba(0,229,176,0.2);
    border-radius: 100px;
    padding: 4px 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
  }

  .live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  /* HERO */
  .hero {
    padding: 3rem 2.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    max-width: 700px;
    margin-bottom: 1rem;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero p {
    color: var(--muted);
    font-size: 1rem;
    max-width: 500px;
    line-height: 1.6;
  }

  /* STATS ROW */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
  }

  .stat-cell {
    padding: 1.5rem 2.5rem;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child { border-right: none; }

  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat-delta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    margin-top: 4px;
  }

  .up { color: var(--green); }
  .down { color: var(--red); }
  .neutral { color: var(--amber); }

  /* MAIN GRID */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    min-height: calc(100vh - 300px);
  }

  /* LEFT PANEL */
  .left-panel {
    border-right: 1px solid var(--border);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .filter-tabs {
    display: flex;
    gap: 4px;
  }

  .tab {
    padding: 5px 12px;
    border-radius: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--muted);
    transition: all 0.15s;
  }

  .tab.active, .tab:hover {
    background: rgba(0,229,176,0.1);
    border-color: rgba(0,229,176,0.3);
    color: var(--accent);
  }

  /* TRADE TABLE */
  .trade-table {
    width: 100%;
    border-collapse: collapse;
  }

  .trade-table thead tr {
    border-bottom: 1px solid var(--border);
  }

  .trade-table th {
    padding: 0.75rem 2rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    font-weight: 400;
  }

  .trade-table tbody tr {
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
  }

  .trade-table tbody tr:hover { background: rgba(255,255,255,0.025); }
  .trade-table tbody tr.selected { background: rgba(0,229,176,0.04); border-left: 2px solid var(--accent); }

  .trade-table td {
    padding: 1rem 2rem;
    font-size: 0.875rem;
  }

  .ticker-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ticker-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
  }

  .ticker-name {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }

  .ticker-full {
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 2px;
  }

  .badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-buy { background: rgba(0,208,133,0.12); color: var(--green); }
  .badge-sell { background: rgba(255,77,109,0.12); color: var(--red); }

  .signal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .signal-dots {
    display: flex;
    gap: 3px;
  }

  .signal-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
  }

  .mono-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
  }

  /* RIGHT PANEL — RECOMMENDATIONS */
  .right-panel {
    background: var(--bg2);
  }

  .rec-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .rec-title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .rec-sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .rec-card {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
  }

  .rec-card:hover { background: rgba(255,255,255,0.02); }

  .rec-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .rec-ticker {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .rec-score {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    padding: 4px 10px;
    border-radius: 100px;
  }

  .score-strong { background: rgba(0,229,176,0.1); color: var(--accent); border: 1px solid rgba(0,229,176,0.2); }
  .score-mod { background: rgba(0,153,255,0.1); color: var(--accent2); border: 1px solid rgba(0,153,255,0.2); }
  .score-watch { background: rgba(255,170,0,0.1); color: var(--amber); border: 1px solid rgba(255,170,0,0.2); }
  .score-avoid { background: rgba(255,77,109,0.12); color: var(--red); border: 1px solid rgba(255,77,109,0.25); }
  .score-caution { background: rgba(255,77,109,0.07); color: #ff8fa3; border: 1px solid rgba(255,77,109,0.15); }

  .rec-card.sell-signal { border-left: 2px solid rgba(255,77,109,0.35); }
  .rec-card.buy-signal { border-left: 2px solid rgba(0,229,176,0.3); }

  .rec-panel-tabs {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  .rec-tab {
    padding: 4px 11px;
    border-radius: 5px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--border2);
    color: var(--muted);
    transition: all 0.15s;
  }

  .rec-tab.active-buy, .rec-tab:hover { background: rgba(0,229,176,0.08); border-color: rgba(0,229,176,0.25); color: var(--accent); }
  .rec-tab.active-sell { background: rgba(255,77,109,0.08); border-color: rgba(255,77,109,0.25); color: var(--red); }
  .rec-tab.active-all { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.15); color: var(--text); }

  .sell-divider {
    padding: 8px 1.5rem;
    background: rgba(255,77,109,0.04);
    border-top: 1px solid rgba(255,77,109,0.1);
    border-bottom: 1px solid rgba(255,77,109,0.1);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ff8fa3;
  }

  .buy-divider {
    padding: 8px 1.5rem;
    background: rgba(0,229,176,0.03);
    border-top: 1px solid rgba(0,229,176,0.08);
    border-bottom: 1px solid rgba(0,229,176,0.08);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .rec-company { font-size: 0.8rem; color: var(--muted); margin-bottom: 0.75rem; }

  .rec-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 0.875rem;
  }

  .rec-metric {
    background: var(--bg3);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .rec-metric-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3px;
  }

  .rec-metric-val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .rec-reason {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .rec-reason strong {
    color: var(--text);
    font-weight: 700;
  }

  /* CHART SECTION */
  .chart-section {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .chart-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  /* DISCLAIMER */
  .disclaimer {
    padding: 1rem 1.5rem;
    background: rgba(255,170,0,0.04);
    border-top: 1px solid rgba(255,170,0,0.1);
    margin: 0 1.5rem 1.5rem;
    border-radius: 8px;
  }

  .disclaimer p {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    color: var(--amber);
    line-height: 1.6;
    opacity: 0.8;
  }

  /* HEATMAP ROW */
  .heatmap-section {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .heatmap-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-top: 1rem;
  }

  .heatmap-cell {
    aspect-ratio: 1;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
